---
import { avatarImg } from '../lib/images';

interface Props {
  size?: number;
  class?: string;
}

const { size = 56, class: className = 'avatar' } = Astro.props;
const img = avatarImg(size);
---

<img
  class={className}
  src={img.src}
  srcset={img.srcset}
  alt=""
  width={img.width}
  height={img.height}
  decoding="async"
  fetchpriority="high"
/>
