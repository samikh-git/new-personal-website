---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <span>{site.location}</span>
    <span>
      © {year}
      {' '}
      <a href={site.github} target="_blank" rel="noopener noreferrer"
        >{site.name}</a
      >
    </span>
  </div>
</footer>
