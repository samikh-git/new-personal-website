---
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
}

const { title, description, pubDate } = Astro.props;

const formatted = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout title={title} description={description}>
  <Nav slot="nav" />
  <header class="post-banner">
    <div class="post-banner__inner">
      <p class="post-banner__meta">
        <time datetime={pubDate.toISOString()}>{formatted}</time>
      </p>
      <h1>{title}</h1>
      <p class="post-banner__desc">{description}</p>
    </div>
  </header>
  <article class="prose prose-width">
    <slot />
  </article>
  <Footer slot="footer" />
</BaseLayout>
