---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
---

<BaseLayout title="About" description={`About ${site.name}`}>
  <Nav slot="nav" />
  <div class="about prose-width">
    <div class="about__identity">
      <h1>About</h1>
      <img
        class="avatar"
        src={site.avatar}
        alt=""
        width="56"
        height="56"
        decoding="async"
      />
    </div>
    <p>
      I'm <strong>{site.name}</strong>. I live in {site.location} and build
      tools for coding agents: CLIs, MCP wiring, sandboxes that keep provider
      keys out of the container.
    </p>
    <p>
      Lately that means <a
        class="arrow-link"
        href="https://github.com/samikh-git/skiff"
        target="_blank"
        rel="noopener noreferrer">skiff</a
      >, a Rust CLI for MCP, OpenAPI, and GraphQL, plus a workspace stack for
      running agents on machines you own.
    </p>
    <p>
      Code is on <a
        class="arrow-link"
        href={site.github}
        target="_blank"
        rel="noopener noreferrer">GitHub</a
      >. I'm
      <a
        class="arrow-link"
        href={site.twitter}
        target="_blank"
        rel="noopener noreferrer">@{site.twitterHandle}</a
      > on X.
    </p>
  </div>
  <Footer slot="footer" />
</BaseLayout>
